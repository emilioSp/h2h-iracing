{# ─── INSTALL ────────────────────────────────────────────── #}
<section class="pw-section" id="install">
  <div class="pw-wrap">

    <div class="pw-section-head" data-reveal>
      <div class="pw-secnum">/ 04<b>Setup</b></div>
      <h2 class="pw-sectitle">Up and running in <b>under a minute.</b></h2>
    </div>

    <div class="pw-install" data-reveal>
      <div></div>
      <div class="pw-steps">

        <div class="pw-step">
          <div class="pw-stepn">01</div>
          <h3 class="pw-step-title">Download the zip</h3>
          <p class="pw-step-desc">
            Grab the latest release from
            <a
              href="{{ site.releaseUrl }}"
              class="text-fg underline underline-offset-4 hover:text-accent transition-colors"
              target="_blank"
              rel="noopener noreferrer"
            >GitHub</a>.
            Unzip it anywhere on your Windows machine — no installer required.
          </p>
        </div>

        <div class="pw-step">
          <div class="pw-stepn">02</div>
          <h3 class="pw-step-title">Run <code>h2h-iracing.exe</code></h3>
          <p class="pw-step-desc">
            A welcome page opens in your browser with one-click links to every
            overlay, ready to use.
          </p>
        </div>

        <div class="pw-step">
          <div class="pw-stepn">03</div>
          <h3 class="pw-step-title">Add to SimHub or OBS</h3>
          <p class="pw-step-desc">
            Import the bundled SimHub dashboards, or paste the overlay URLs as
            Browser Sources in OBS. Start iRacing and race.
          </p>
        </div>

      </div>
    </div>

    <a
      href="{{ site.releaseUrl }}"
      target="_blank"
      rel="noopener noreferrer"
      class="pw-install-cta"
      data-reveal
    >
      <span>Get the latest release</span>
      <small>↗ v{{ site.version }}</small>
    </a>

  </div>
</section>

<div class="pw-stripe" aria-hidden="true"></div>
