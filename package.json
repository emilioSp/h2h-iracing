{
  "name": "h2h-iracing",
  "version": "1.36.0",
  "description": "Head 2 Head iRacing dashboards",
  "license": "MIT",
  "author": "Emilio Spatola",
  "type": "module",
  "main": "index.js",
  "imports": {
    "#server/*": "./src/server/*",
    "#dashboard/*": "./src/server/dashboard/*",
    "#service/*": "./src/server/service/*",
    "#repository/*": "./src/server/repository/*",
    "#schema/*": "./src/schema/*",
    "#common/*": "./src/common/*",
    "#config": "./src/server/config.ts",
    "#router/*": "./src/server/router/*",
    "#h2h-dashboard/*": "./src/h2h-dashboard/src/*",
    "#weather-dashboard/*": "./src/weather-dashboard/src/*",
    "#car-dashboard/*": "./src/car-dashboard/src/*",
    "#fuel-dashboard/*": "./src/fuel-dashboard/src/*",
    "#spotter-dashboard/*": "./src/spotter-dashboard/src/*",
    "#traffic-dashboard/*": "./src/traffic-dashboard/src/*",
    "#fixtures/*": "./tests/fixtures/*"
  },
  "scripts": {
    "server:start:dev": "npm run h2h:build & npm run weather:build & npm run car:build & npm run fuel:build & npm run spotter:build & npm run traffic:build & DATA_MODE=mock node --env-file=.env --watch src/server/server.ts",
    "server:start": "node --env-file=.env src/server/server.ts",
    "inspect-memory-dump": "node --env-file=.env examples/inspect-memory-dump.ts",
    "cli:start:dev": "DATA_MODE=mock node --env-file=.env examples/cli.ts",
    "cli:start": "node --env-file=.env examples/cli.ts",
    "cli:fuel:dev": "DATA_MODE=mock node --env-file=.env examples/fuel-cli.ts",
    "cli:fuel": "node --env-file=.env examples/fuel-cli.ts",
    "h2h:start:dev": "vite --config vite.h2h.config.ts",
    "h2h:build": "vite build --config vite.h2h.config.ts",
    "weather:start:dev": "vite --config vite.weather.config.ts",
    "weather:build": "vite build --config vite.weather.config.ts",
    "car:start:dev": "vite --config vite.car.config.ts",
    "car:build": "vite build --config vite.car.config.ts",
    "fuel:start:dev": "vite --config vite.fuel.config.ts",
    "fuel:build": "vite build --config vite.fuel.config.ts",
    "spotter:start:dev": "vite --config vite.spotter.config.ts",
    "spotter:build": "vite build --config vite.spotter.config.ts",
    "traffic:start:dev": "vite --config vite.traffic.config.ts",
    "traffic:build": "vite build --config vite.traffic.config.ts",
    "test": "vitest run --coverage --config vitest.config.ts",
    "test:e2e": "playwright test",
    "build": "tsc",
    "check": "npm run build && npm run fmt && npm run lint && npm run test && npm run test:e2e",
    "fmt": "oxfmt",
    "lint": "oxlint --fix",
    "package": "node scripts/package.ts",
    "release": "npm run package && gh release create v${npm_package_version} \"./h2h-iracing-${npm_package_version}.zip\" --generate-notes",
    "site:css": "tailwindcss -i site/_css/site.css -o site/assets/css/style.css",
    "site:build": "npm run site:css && eleventy",
    "site:dev": "npm run site:css && (tailwindcss -i site/_css/site.css -o site/assets/css/style.css --watch &) && eleventy --serve"
  },
  "dependencies": {
    "@emiliosp/node-iracing-sdk": "1.4.0",
    "@hono/node-server": "2.1.5",
    "hono": "4.13.13",
    "lucide-react": "1.59.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwindcss": "4.3.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@11ty/eleventy": "3.1.7",
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "1.64.1",
    "@tailwindcss/cli": "4.3.3",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "@yao-pkg/pkg": "6.23.0",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "oxlint-anti-slop": "0.3.8",
    "resedit": "3.1.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
