{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "overrides": [
    {
      "files": ["*.md", "*.mdx"],
      "options": {
        "printWidth": 170,
        "proseWrap": "always"
      }
    }
  ],
  "useTabs": false,
  "tabWidth": 2,
  "singleQuote": true,
  "sortImports": true,
  "ignorePatterns": [
    "dist/**",
    "build/**",
    "coverage/**",
    "node_module/**",
    "tests/fixtures/**",
    ".pi/**",
    ".cache/**",
    ".idea/**",
    ".specs/**",
    "_site/**",
    "vendor/**"
  ]
}
