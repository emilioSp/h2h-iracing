{# ─── VIDEO ──────────────────────────────────────────────── #}
<section class="py-16 md:py-28 px-6 md:px-12 bg-stone-50 border-t border-zinc-200">
  <div class="max-w-7xl mx-auto">

    <div class="mb-12 md:mb-16" data-reveal>
      <span class="section-number font-display font-extrabold uppercase block">03</span>
      <h2 class="font-display font-extrabold uppercase text-5xl md:text-6xl mt-2 pl-5 border-l-4 border-accent leading-tight">
        SEE IT IN<br />ACTION
      </h2>
    </div>

    <div class="border-2 border-zinc-200" data-reveal>
      <div
        id="yt-container"
        class="relative aspect-video w-full overflow-hidden cursor-pointer bg-zinc-100"
        data-video-id="{{ site.youtubeId }}"
      >
        <img
          id="yt-poster"
          src="https://img.youtube.com/vi/{{ site.youtubeId }}/maxresdefault.jpg"
          alt="H2H iRacing video demonstration"
          class="absolute inset-0 w-full h-full object-cover"
        />
        <div class="absolute inset-0 grid place-items-center">
          <button
            type="button"
            class="group grid place-items-center w-20 h-20 bg-accent hover:bg-zinc-900 transition-colors duration-150"
            aria-label="Play video"
          >
            <svg
              class="w-8 h-8 text-white transition-colors duration-150 ml-1"
              fill="currentColor"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path d="M8 5v14l11-7z" />
            </svg>
          </button>
        </div>
      </div>
    </div>

  </div>
</section>
