{# ─── HOW TO GET IT ──────────────────────────────────────── #}
<section class="py-16 md:py-28 px-6 md:px-12 bg-white border-t border-zinc-200">
  <div class="max-w-7xl mx-auto">

    <div class="mb-12 md:mb-16" data-reveal>
      <span class="section-number font-display font-extrabold uppercase block">04</span>
      <h2 class="font-display font-extrabold uppercase text-5xl md:text-6xl mt-2 pl-5 border-l-4 border-accent leading-tight">
        HOW TO GET IT
      </h2>
    </div>

    <div class="mb-12">

      <div class="grid grid-cols-[auto_1fr] gap-6 md:gap-10 border-t border-zinc-200 py-8" data-reveal>
        <span class="font-display font-extrabold text-3xl md:text-4xl text-accent w-10 md:w-14 tabular-nums">
          01
        </span>
        <div>
          <h3 class="font-display font-bold uppercase text-2xl md:text-3xl mb-3 tracking-wide">
            DOWNLOAD THE ZIP
          </h3>
          <p class="text-sm text-zinc-600 leading-relaxed">
            Go to the
            <a
              href="{{ site.releaseUrl }}"
              class="text-zinc-900 underline underline-offset-4 hover:text-accent transition-colors"
              target="_blank"
              rel="noopener noreferrer"
            >releases page</a>
            and grab the latest version. Unzip it anywhere on your Windows machine.
          </p>
        </div>
      </div>

      <div class="grid grid-cols-[auto_1fr] gap-6 md:gap-10 border-t border-zinc-200 py-8" data-reveal>
        <span class="font-display font-extrabold text-3xl md:text-4xl text-accent w-10 md:w-14 tabular-nums">
          02
        </span>
        <div>
          <h3 class="font-display font-bold uppercase text-2xl md:text-3xl mb-3 tracking-wide">
            RUN h2h-iracing.exe
          </h3>
          <p class="text-sm text-zinc-600 leading-relaxed">
            Double-click
            <code class="font-mono text-zinc-800 bg-zinc-100 px-1.5 py-0.5">h2h-iracing.exe</code>
            to start the server. A welcome page opens in your browser with setup
            instructions and a link to each overlay.
          </p>
        </div>
      </div>

      <div class="grid grid-cols-[auto_1fr] gap-6 md:gap-10 border-t border-zinc-200 border-b border-zinc-200 py-8" data-reveal>
        <span class="font-display font-extrabold text-3xl md:text-4xl text-accent w-10 md:w-14 tabular-nums">
          03
        </span>
        <div>
          <h3 class="font-display font-bold uppercase text-2xl md:text-3xl mb-3 tracking-wide">
            ADD TO SIMHUB OR OBS
          </h3>
          <p class="text-sm text-zinc-600 leading-relaxed">
            Import the included SimHub dashboards, or paste the overlay URLs as Browser
            Sources in OBS. Start iRacing and race.
          </p>
        </div>
      </div>

    </div>

    <div data-reveal>
      <a
        href="{{ site.releaseUrl }}"
        class="inline-block bg-accent hover:bg-zinc-900 hover:text-white transition-colors duration-150 px-8 py-5 font-display font-extrabold text-2xl md:text-3xl uppercase tracking-wide text-white"
        target="_blank"
        rel="noopener noreferrer"
      >
        GET THE LATEST RELEASE ↗
      </a>
    </div>

  </div>
</section>

<div
  class="h-3 w-full"
  aria-hidden="true"
  style="background-image: repeating-conic-gradient(#161616 0% 25%, rgba(227,0,0,0.2) 0% 50%); background-size: 12px 12px;"
></div>
