{# ─── VIDEO ──────────────────────────────────────────────── #}
<section class="pw-section" id="video">
  <div class="pw-wrap">

    <div class="pw-section-head" data-reveal>
      <div class="pw-secnum">/ 03<b>In action</b></div>
      <h2 class="pw-sectitle">See the gap, <b>close the gap.</b></h2>
    </div>

    <div class="pw-video-wrap" data-reveal>
      <div></div>
      <div
        id="yt-container"
        class="pw-video"
        data-video-id="{{ site.youtubeId }}"
      >
        <img
          id="yt-poster"
          src="https://img.youtube.com/vi/{{ site.youtubeId }}/maxresdefault.jpg"
          alt="H2H iRacing demo"
        />
        <button class="pw-video-play" aria-label="Play demo">
          <svg width="32" height="32" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M8 5v14l11-7z" />
          </svg>
        </button>
      </div>
    </div>

  </div>
</section>
