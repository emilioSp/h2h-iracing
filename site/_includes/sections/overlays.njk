{# ─── OVERLAYS ──────────────────────────────────────────── #}
<section class="pw-section" id="overlays">
  <div class="pw-wrap">

    <div class="pw-section-head" data-reveal>
      <div class="pw-secnum">/ 02<b>The overlays</b></div>
      <h2 class="pw-sectitle">Many overlays. <b>One download.</b></h2>
    </div>

    <div class="pw-overlays-grid" data-reveal>
      <div></div>
      <div class="pw-overlays-list">

        <div class="pw-overlay-row">
          <div class="pw-overlay-num">01</div>
          <div class="pw-overlay-name">Head-to-Head</div>
          <div class="pw-overlay-desc">
            See the cars ahead and behind in real time — live gap, delta per
            lap, and lap times for every battle.
          </div>
        </div>

        <div class="pw-overlay-row">
          <div class="pw-overlay-num">02</div>
          <div class="pw-overlay-name">Fuel</div>
          <div class="pw-overlay-desc">
            Know exactly how much fuel to add at your next pit stop, with zero,
            half and full-lap safety margins.
          </div>
        </div>

        <div class="pw-overlay-row">
          <div class="pw-overlay-num">03</div>
          <div class="pw-overlay-name">Weather</div>
          <div class="pw-overlay-desc">
            Air and track temperature, track wetness, plus a wind rose that
            orients itself to the car.
          </div>
        </div>

        <div class="pw-overlay-row">
          <div class="pw-overlay-num">04</div>
          <div class="pw-overlay-name">Car Telemetry</div>
          <div class="pw-overlay-desc">
            ABS, traction control, brake bias and pit limiter.
          </div>
        </div>

      </div>
    </div>

    <div class="pw-gallery" data-reveal>
      <figure>
        <img
          src="{{ '/images/H2H_dashboard.jpg' | url }}"
          alt="Head-to-Head overlay"
        />
        <figcaption><b>H2H Battle</b></figcaption>
      </figure>
      <figure>
        <img
          src="{{ '/images/H2H_fuel_dashboard.png' | url }}"
          alt="Fuel overlay"
        />
        <figcaption><b>Fuel</b></figcaption>
      </figure>
      <figure>
        <img
          src="{{ '/images/H2H_weather_dashboard.jpg' | url }}"
          alt="Weather overlay"
        />
        <figcaption><b>Weather</b></figcaption>
      </figure>
      <figure>
        <img
          src="{{ '/images/H2H_car_telemetry_dashboard.jpg' | url }}"
          alt="Car Telemetry overlay"
        />
        <figcaption><b>Car</b></figcaption>
      </figure>
    </div>

  </div>
</section>
